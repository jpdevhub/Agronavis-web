# Base URL of the Agronavis API (the Render service).
# Local development points at the backend running on your machine.
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Certificate System ─────────────────────────────────────────────
# Public site URL used in verification links and QR codes.
NEXT_PUBLIC_SITE_URL=https://www.agronavis.in

# Admin credentials (username + bcrypt-hashed password).
# Generate a password hash with:  node -e "console.log(require('bcryptjs').hashSync('your-password', 12))"
CERT_ADMIN_USERNAME=admin
CERT_ADMIN_PASSWORD_HASH=$2a$12$examplehashhere

# Secret for signing session tokens (random 32+ char string).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CERT_SESSION_SECRET=change-me-to-a-random-secret

# Storage paths (defaults work for local development).
CERT_STORAGE_DIR=./data/certificates
CERT_DB_PATH=./data/certificates.json
